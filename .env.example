# Server
PORT=4001
HOST=0.0.0.0
NODE_ENV=development

# CORS: comma-separated list of allowed browser origins that serve the client
# (dev localhost origins are always allowed when NODE_ENV is not production)
CORS_ORIGIN=

# Optional: enables Redis-backed review caching.
# When unset, the server falls back to a built-in in-memory TTL cache.
REDIS_URL=

# AI
AI_MAX_CONCURRENCY=4
# Max tokens consumed per rolling hour before reviews are rejected (HTTP 429)
AI_BUDGET_TOKENS_PER_HOUR=200000

# Logging (pino): trace | debug | info | warn | error | fatal
LOG_LEVEL=info