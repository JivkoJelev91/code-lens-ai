{
  "name": "@code-lens-ai/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "eval": "tsx src/evals/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@code-lens-ai/shared": "workspace:*",
    "@opencode-ai/sdk": "1.18.30",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}